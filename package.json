{
  "name": "keyboard-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test:buyer-ui": "node scripts/verify-buyer-ui.mjs",
    "backup:local": "node scripts/backup-local.mjs backup",
    "backup:drill": "node scripts/backup-local.mjs backup --verify",
    "backup:verify": "node scripts/backup-local.mjs verify",
    "test:m7-local": "node scripts/run-local-regression.mjs",
    "test:container": "node scripts/verify-container.mjs",
    "release:hp": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/package-hp-release.ps1",
    "test:m6-local": "node scripts/run-local-regression.mjs",
    "test:m5-local": "node --experimental-strip-types scripts/verify-m1-local.mjs --browser",
    "notify:once": "node --experimental-strip-types scripts/notification-worker.mjs --once",
    "notify:worker": "node --experimental-strip-types scripts/notification-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:m1-local": "node --experimental-strip-types scripts/verify-m1-local.mjs",
    "test:catalog-ui": "node --experimental-strip-types scripts/verify-m1-local.mjs --browser",
    "test:m3-local": "node --experimental-strip-types scripts/verify-m1-local.mjs --browser",
    "test:m4-local": "node --experimental-strip-types scripts/verify-m1-local.mjs --browser",
    "test:storefront": "node --experimental-strip-types scripts/verify-m1-local.mjs --browser",
    "assets": "node scripts/generate-assets.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:push": "supabase db push",
    "db:check": "supabase db advisors --type security --fail-on error",
    "db:types": "node scripts/generate-db-types.mjs",
    "admin:bootstrap": "node --env-file=.env.bootstrap.local --experimental-strip-types scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.1",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.11.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.1",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsqr": "1.4.0",
    "supabase": "3.2.0",
    "typescript": "^5"
  }
}
