# Local `npm run dev`: không cần .env (mặc định localhost:3000).
# HP: copy file này thành .env, không commit .env.
# Compose maps PUBLIC_URL to APP_ORIGIN at runtime. No NEXT_PUBLIC secrets.
PUBLIC_URL=https://trumpkeys.publice.io.vn
# Same-origin only; startup rejects a different origin or wildcard. No cross-origin API.
CORS_ORIGINS=https://trumpkeys.publice.io.vn
# 8094 dự kiến; cần kiểm tra cổng trống trên HP trước khi up.
WEB_PORT=8094
# Mỗi lần build dùng tag mới; giữ image tag cũ để rollback.
IMAGE_TAG=local
# Separate tunnel, profile `tunnel`; never reuse banking-tunnel token.
TUNNEL_TOKEN=
TUNNEL_METRICS_PORT=2094
# M1: chỉ server gọi Supabase; không cần NEXT_PUBLIC_* hoặc key ở client bundle.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# M3: secret chỉ ở server runtime để tra cứu DTO/ký URL Storage private.
SUPABASE_SECRET_KEY=
# Bootstrap local: xem docs/M1-AUTH.md, không có endpoint web cấp quyền đầu tiên.
# M5: server only. Leave disabled until credentials/model and data terms reviewed.
GEMINI_ENABLED=false
PREFER_IPV4=false
GEMINI_API_KEY=
GEMINI_MODEL=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# No app DB password/JWT secret: managed Supabase owns DB/Auth and signs JWTs.
# Google client secret belongs in Supabase Auth provider settings, never here/client.
# Operator backup uses a separate private directory; see docs/HP-BACKUP-RESTORE.md.
# Generate operator passwords locally on HP with: openssl rand -hex 32
