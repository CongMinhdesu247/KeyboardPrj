# Copy thành .env.local để làm trên PC. Không copy .env HP để chạy PC.
APP_ORIGIN=http://localhost:3000
# Lấy từ npx supabase status sau khi Docker/local stack hoạt động.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# M3: chỉ server dùng key này để ký ảnh và đọc DTO của đúng mã đơn.
# Không dùng NEXT_PUBLIC_ và không đưa vào trình duyệt.
SUPABASE_SECRET_KEY=
# M5: server only; keep disabled until credentials/model are configured.
GEMINI_ENABLED=false
PREFER_IPV4=false
GEMINI_API_KEY=
GEMINI_MODEL=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
